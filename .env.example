# Copy this file to .env and add your API key locally. Never use a VITE_ prefix
# for the secret: variables prefixed with VITE_ are sent to the browser.
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional Gemini provider: set GEMINI_API_KEY to select it automatically,
# or set AI_PROVIDER=gemini. The key remains server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VITE_API_BASE_URL=http://localhost:8000/api
